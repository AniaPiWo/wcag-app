# ============================================
# WCAG App - Environment Variables
# ============================================
# Skopiuj ten plik jako .env i wypełnij własnymi wartościami
# NIE COMMITUJ pliku .env do repozytorium!

# ============================================
# SESSION & AUTHENTICATION
# ============================================

# Sekret do podpisywania JWT tokenów sesji
# WYMAGANE: Minimum 32 znaki, użyj silnego losowego ciągu
# Generuj: openssl rand -base64 32
SESSION_SECRET=your-secret-key-minimum-32-characters-long-random-string

# Login administratora
ADMIN_LOGIN=admin

# Hasło administratora
# WAŻNE: Użyj silnego hasła (min. 12 znaków, mix liter/cyfr/symboli)
ADMIN_PASSWORD=your-secure-admin-password

# ============================================
# EMAIL SERVICE (Resend)
# ============================================

# API Key z https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email nadawcy (musi być zweryfikowany w Resend)
RESEND_FROM_EMAIL=biuro@wcag.co

# ============================================
# AI SERVICE (OpenAI)
# ============================================

# API Key z https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# DATABASE (PostgreSQL)
# ============================================

# Connection string do bazy danych PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Przykład lokalny: postgresql://postgres:password@localhost:5432/wcag_db
# Przykład Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/wcag_app

# ============================================
# OPTIONAL
# ============================================

# Środowisko (development, production, test)
NODE_ENV=development

# Sekretny klucz API dla dostępu do endpointów administracyjnych
# Opcjonalne - jeśli nie ustawione, wymaga sesji
API_SECRET_KEY=

# ============================================
# DEPLOYMENT (Vercel/Production)
# ============================================

# Dla Vercel dodaj te zmienne w: Settings > Environment Variables
# Upewnij się że SESSION_SECRET i ADMIN_PASSWORD są różne dla każdego środowiska!

# ============================================
# QUICK START
# ============================================
#
# 1. Skopiuj ten plik:
#    cp env.example .env
#
# 2. Wygeneruj SESSION_SECRET:
#    openssl rand -base64 32
#
# 3. Ustaw ADMIN_LOGIN i ADMIN_PASSWORD
#
# 4. Dodaj klucze API:
#    - RESEND_API_KEY z https://resend.com
#    - OPENAI_API_KEY z https://platform.openai.com
#
# 5. Skonfiguruj DATABASE_URL (PostgreSQL)
#
# 6. Uruchom:
#    npm run dev
#
# ============================================
# SECURITY NOTES
# ============================================
# 
# 1. SESSION_SECRET:
#    - Minimum 32 znaki
#    - Użyj losowego ciągu (openssl rand -base64 32)
#    - Różny dla dev/staging/production
#
# 2. ADMIN_PASSWORD:
#    - Minimum 12 znaków
#    - Mix wielkich/małych liter, cyfr, symboli
#    - Nie używaj słownikowych słów
#
# 3. API KEYS:
#    - Nigdy nie commituj do repozytorium
#    - Rotuj regularnie (co 90 dni)
#    - Używaj różnych kluczy dla dev/prod
#
# 4. DATABASE_URL:
#    - Używaj silnych haseł
#    - Ogranicz dostęp do IP
#    - Włącz SSL w produkcji
#
# ============================================
